{
  "name": "truckers-tool-linux",
  "private": true,
  "version": "1.1.3-alpha.7",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "homepage": "./",
  "scripts": {
    "dev": "concurrently -n \"next,api\" -c \"cyan,yellow\" \"next dev -p 3214\" \"tsx watch server/index.ts\"",
    "dev:frontend": "next dev -p 3214",
    "dev:backend": "tsx watch server/index.ts",
    "build": "next build",
    "build:frontend": "cross-env IS_ELECTRON=true NODE_OPTIONS=--max-old-space-size=2048 next build",
    "build:backend": "tsup server/index.ts --format cjs --out-dir dist-server",
    "build:electron": "tsup electron/main.ts electron/preload.ts --format cjs --out-dir dist-electron --external electron,electron-updater,electron-serve",
    "build:all": "npm run build:frontend && npm run build:backend && npm run build:electron",
    "pack": "npm run build:all && electron-builder --dir",
    "dist": "npm run build:all && electron-builder",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:logs": "pm2 logs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@trucky/sii-decrypt-ts": "^1.0.0",
    "adm-zip": "^0.5.16",
    "cors": "^2.8.5",
    "electron-serve": "^3.0.1",
    "express": "^5.1.0",
    "js-yaml": "^4.1.1",
    "multer": "^2.1.0",
    "next": "^16.1.6",
    "nodemailer": "^8.0.1",
    "postcss": "^8.5.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "electron-updater": "^6.8.3",
    "tailwindcss": "^4.1.4",
    "tsup": "^8.5.1",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3"
  }
}
